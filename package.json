{
  "name": "bc-claude",
  "version": "0.1.0",
  "description": "MCP-Server (stdio), mit dem Claude Business Central über das BC-OpenBridge-Gateway bedient – agentengerechte Werkzeuge, zweistufige Änderungen, keine eigenen Rechte.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bc-claude": "src/server.ts"
  },
