{
  "name": "bc-atlas",
  "version": "0.11.0",
  "description": "BC Atlas maps Microsoft Dynamics 365 Business Central AL projects: architecture diagrams, health checks, reports, and documentation generated from source.",
  "homepage": "https://github.com/SchulzOli/BC-Atlas#readme",
  "bugs": {
    "url": "https://github.com/SchulzOli/BC-Atlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchulzOli/BC-Atlas.git"
  },
  "type": "module",
  "bin": {
    "bca": "./src/cli.js",
    "bca-mcp": "./src/mcp.js"
  },
  "files": [
    "src/",
    "vendor/",
    ".bca.example.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node ./src/cli.js",
    "test": "node --import ./test/setup.js --test",
    "check": "node ./scripts/check-syntax.js && npm run docs:check",
    "docs": "node ./scripts/generate-docs.js",
    "docs:check": "node ./scripts/generate-docs.js --check",
    "examples": "node ./scripts/generate-examples.js",
    "mcp": "node ./src/mcp.js",
    "prepack": "npm run check && npm test",
    "update:grammar": "node ./scripts/update-grammar.js",
    "site:dev": "vitepress dev website",
    "site:build": "vitepress build website && node ./scripts/site-assets.js",
    "site:preview": "vitepress preview website",
    "version:set": "node ./scripts/set-version.js",
    "update:graph-vendor": "node ./scripts/build-graph-vendor.js",
    "update:font-metrics": "node ./scripts/build-font-metrics.js"
  },
  "keywords": [
    "al",
    "business-central",
    "d2",
    "architecture",
    "dependency-graph",
    "documentation",
    "dynamics-365",
    "static-analysis",
    "tree-sitter",
    "mcp",
    "architecture-health"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.1",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "3d-force-graph": "^1.80.0",
    "bpmn-moddle": "^10.3.1",
    "esbuild": "^0.28.2",
    "jsonld": "^9.0.0",
    "n3": "^2.13.12",
    "opentype.js": "^2.0.0",
    "rdfxml-streaming-parser": "^3.3.0",
    "three": "^0.186.1",
    "vitepress": "2.0.0-alpha.20"
  }
}
