{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SchulzOli/BC-Atlas/blob/main/schemas/bca.schema.json",
  "title": "BC Atlas configuration (.bca.json)",
  "description": "Settings for bca check, view, export, layers, and docs. See docs/configuration.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projectRoot": {
      "description": "Root of the AL project, relative to this file.",
      "type": "string"
    },
    "paths": {
      "description": "Analyze only these folders (globs allowed).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "types": {
      "description": "Analyze only objects of these types, such as table or codeunit (like --type).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "description": "Files to leave out of the analysis (globs).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceUrl": {
      "description": "Link template for source locations: {ref}, {file}, {line}.",
      "type": "string"
    },
    "sourceRef": {
      "type": "string"
    },
    "sourcePathPrefix": {
      "type": "string"
    },
    "forbiddenDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "properties": {
        "failOn": {
          "enum": [
            "error",
            "warning",
            "info",
            "never"
          ]
        },
        "cycles": {
          "enum": [
            "error",
            "warning",
            "info",
            "off"
          ]
        },
        "maxFanIn": {
          "type": "integer",
          "minimum": 1
        },
        "maxFanOut": {
          "type": "integer",
          "minimum": 1
        },
        "severities": {
          "description": "Severity of the quality rules: error, warning, info, or off.",
          "type": "object",
          "properties": {
            "undocumented-public-api": {
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "default": "info"
            }
          }
        },
        "contractExpectations": {
          "type": "array"
        },
        "contexts": {
          "type": "array"
        },
        "undeclaredDependencies": {
          "description": "Severity of an app that uses another without naming it in the dependencies of its app.json.",
          "enum": [
            "error",
            "warning",
            "info",
            "off"
          ],
          "default": "warning"
        },
        "documentation": {
          "description": "Severity of what the user guides from the AL UI tests do not cover: a page a user opens that no guide shows (page-without-guide), and a UI test without [SCENARIO] (undocumented-ui-test). Off by default.",
          "enum": [
            "error",
            "warning",
            "info",
            "off"
          ],
          "default": "off"
        }
      }
    },
    "al": {
      "description": "How the AL workspace is read.",
      "type": "object",
      "properties": {
        "workspaceFile": {
          "description": "The .code-workspace file whose folders and al.packageCachePath apply, relative to the project root. Default: the one in the root, when there is exactly one.",
          "type": "string"
        }
      }
    },
    "layers": {
      "description": "The layered documentation (bca layers): the system explained from the whole down to each procedure, kept in sync with the source.",
      "type": "object",
      "properties": {
        "outputDir": {
          "type": "string",
          "default": "docs/layers"
        },
        "pictures": {
          "description": "Pictures of single objects: auto (up to 400 objects), all, or none (no pictures at all).",
          "enum": [
            "auto",
            "all",
            "none"
          ],
          "default": "auto"
        },
        "view": {
          "description": "Also write view.html, the BC Atlas view as one offline file.",
          "type": "boolean",
          "default": false
        },
        "pages": {
          "description": "Which pages are written. false leaves a kind of page out; a list keeps the pages of a kind whose name, id, or file name matches one of its entries (* and ? are wildcards). Default: every page.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readme": {
              "type": "boolean",
              "default": true
            },
            "architecture": {
              "type": "boolean",
              "default": true
            },
            "findings": {
              "type": "boolean",
              "default": true
            },
            "apps": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "default": true
            },
            "namespaces": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "default": true
            },
            "objects": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "default": true
            },
            "lenses": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "default": true
            },
            "stories": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "default": true
            }
          }
        },
        "scope": {
          "description": "The part of the system that is documented: only the objects that match every list that is not empty get a page, and an app or namespace gets one when it holds such an object. * and ? are wildcards; case does not matter.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apps": {
              "description": "Names of apps.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "namespaces": {
              "description": "Namespaces; Contoso.Sales* also takes the ones below it.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "types": {
              "description": "Object types, such as table, codeunit, page.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude": {
              "description": "Objects to leave out, by name (CON Item) or by type, ID, and name (table 50000 CON Item).",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sections": {
          "description": "The sections (the headings of the second level) of each kind of page, in the order to write them. A section that is not named is left out; one a page does not have is skipped. Default: every section. Sections are named in English, whatever the language.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readme": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Start here",
                  "Layers",
                  "Apps",
                  "Namespaces",
                  "Lenses",
                  "Stories",
                  "Findings",
                  "Read from"
                ]
              }
            },
            "architecture": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Apps",
                  "Namespaces"
                ]
              }
            },
            "findings": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Error",
                  "Warning",
                  "Info"
                ]
              }
            },
            "app": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Namespaces",
                  "Depends on",
                  "Used by",
                  "Objects",
                  "Findings"
                ]
              }
            },
            "namespace": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Depends on",
                  "Used by",
                  "Objects",
                  "Findings"
                ]
              }
            },
            "object": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Inside",
                  "Uses",
                  "Used by",
                  "User guides",
                  "Findings"
                ]
              }
            },
            "lens": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Findings"
                ]
              }
            },
            "story": {
              "description": "The sections of a story are its steps (1. <title>); [] leaves only what stands above them.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "titles": {
          "description": "Other headings: the heading as BC Atlas writes it in English, and what to call it. \"object.Used by\" names the heading of one kind of page; README is the title of the first page.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "language": {
          "description": "de: the fixed headings, table headers, labels, and the footer in German. What is made from the source stays as it is.",
          "enum": [
            "en",
            "de"
          ],
          "default": "en"
        },
        "names": {
          "description": "The file of each kind of page, relative to outputDir, ending with .md. Placeholders: {name}; for objects also {type}, {id}, {app}, {namespace}; for namespaces {app}; for lenses and stories {id}. Links and pictures follow.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readme": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "README.md"
            },
            "architecture": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "architecture.md"
            },
            "findings": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "findings.md"
            },
            "apps": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "apps/{name}.md"
            },
            "namespaces": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "namespaces/{name}.md"
            },
            "objects": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "objects/{type}-{id}-{name}.md"
            },
            "lenses": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "lenses/{id}.md"
            },
            "stories": {
              "type": "string",
              "pattern": "\\.md$",
              "default": "stories/{id}.md"
            }
          }
        },
        "templates": {
          "description": "Folder, relative to the project, with a Markdown template per kind of page: readme.md, architecture.md, findings.md, app.md, namespace.md, object.md, lens.md, story.md. Placeholders: {{title}}, {{summary}}, {{picture}}, {{section \"Uses\"}}, {{body \"Uses\"}}, {{sections}}, {{footer}}, {{name}}, {{type}}, {{id}}, {{app}}, {{namespace}}, {{system}}.",
          "type": "string"
        },
        "profiles": {
          "description": "Named sets of the settings of layers (bca layers --profile <name>): the keys of a profile go over the ones here, each as a whole. Every profile writes to a folder of its own: its outputDir, or <outputDir>-<name>.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outputDir": {
                "type": "string"
              },
              "pictures": {
                "description": "Pictures of single objects: auto (up to 400 objects), all, or none (no pictures at all).",
                "enum": [
                  "auto",
                  "all",
                  "none"
                ],
                "default": "auto"
              },
              "view": {
                "description": "Also write view.html, the BC Atlas view as one offline file.",
                "type": "boolean",
                "default": false
              },
              "pages": {
                "description": "Which pages are written. false leaves a kind of page out; a list keeps the pages of a kind whose name, id, or file name matches one of its entries (* and ? are wildcards). Default: every page.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "readme": {
                    "type": "boolean",
                    "default": true
                  },
                  "architecture": {
                    "type": "boolean",
                    "default": true
                  },
                  "findings": {
                    "type": "boolean",
                    "default": true
                  },
                  "apps": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ],
                    "default": true
                  },
                  "namespaces": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ],
                    "default": true
                  },
                  "objects": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ],
                    "default": true
                  },
                  "lenses": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ],
                    "default": true
                  },
                  "stories": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ],
                    "default": true
                  }
                }
              },
              "scope": {
                "description": "The part of the system that is documented: only the objects that match every list that is not empty get a page, and an app or namespace gets one when it holds such an object. * and ? are wildcards; case does not matter.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "apps": {
                    "description": "Names of apps.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "namespaces": {
                    "description": "Namespaces; Contoso.Sales* also takes the ones below it.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "types": {
                    "description": "Object types, such as table, codeunit, page.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "exclude": {
                    "description": "Objects to leave out, by name (CON Item) or by type, ID, and name (table 50000 CON Item).",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "sections": {
                "description": "The sections (the headings of the second level) of each kind of page, in the order to write them. A section that is not named is left out; one a page does not have is skipped. Default: every section. Sections are named in English, whatever the language.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "readme": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Start here",
                        "Layers",
                        "Apps",
                        "Namespaces",
                        "Lenses",
                        "Stories",
                        "Findings",
                        "Read from"
                      ]
                    }
                  },
                  "architecture": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Apps",
                        "Namespaces"
                      ]
                    }
                  },
                  "findings": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Error",
                        "Warning",
                        "Info"
                      ]
                    }
                  },
                  "app": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Namespaces",
                        "Depends on",
                        "Used by",
                        "Objects",
                        "Findings"
                      ]
                    }
                  },
                  "namespace": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Depends on",
                        "Used by",
                        "Objects",
                        "Findings"
                      ]
                    }
                  },
                  "object": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Inside",
                        "Uses",
                        "Used by",
                        "User guides",
                        "Findings"
                      ]
                    }
                  },
                  "lens": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Findings"
                      ]
                    }
                  },
                  "story": {
                    "description": "The sections of a story are its steps (1. <title>); [] leaves only what stands above them.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "titles": {
                "description": "Other headings: the heading as BC Atlas writes it in English, and what to call it. \"object.Used by\" names the heading of one kind of page; README is the title of the first page.",
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "language": {
                "description": "de: the fixed headings, table headers, labels, and the footer in German. What is made from the source stays as it is.",
                "enum": [
                  "en",
                  "de"
                ],
                "default": "en"
              },
              "names": {
                "description": "The file of each kind of page, relative to outputDir, ending with .md. Placeholders: {name}; for objects also {type}, {id}, {app}, {namespace}; for namespaces {app}; for lenses and stories {id}. Links and pictures follow.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "readme": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "README.md"
                  },
                  "architecture": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "architecture.md"
                  },
                  "findings": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "findings.md"
                  },
                  "apps": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "apps/{name}.md"
                  },
                  "namespaces": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "namespaces/{name}.md"
                  },
                  "objects": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "objects/{type}-{id}-{name}.md"
                  },
                  "lenses": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "lenses/{id}.md"
                  },
                  "stories": {
                    "type": "string",
                    "pattern": "\\.md$",
                    "default": "stories/{id}.md"
                  }
                }
              },
              "templates": {
                "description": "Folder, relative to the project, with a Markdown template per kind of page: readme.md, architecture.md, findings.md, app.md, namespace.md, object.md, lens.md, story.md. Placeholders: {{title}}, {{summary}}, {{picture}}, {{section \"Uses\"}}, {{body \"Uses\"}}, {{sections}}, {{footer}}, {{name}}, {{type}}, {{id}}, {{app}}, {{namespace}}, {{system}}.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "docs": {
      "description": "The user guides from the AL UI tests (bca docs).",
      "type": "object",
      "properties": {
        "tests": {
          "description": "The folder of the documented AL UI tests, relative to the project root. Default: the folder with the most scenarios.",
          "type": "string"
        },
        "outputDir": {
          "description": "Where bca docs generate writes the guides; the pages of bca layers link to them there.",
          "type": "string",
          "default": "docs/generated"
        }
      }
    }
  },
  "$defs": {
    "names": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "selector": {
      "description": "namespace:, folder:, file:, app:, module:, type:, object:type:name, id:from..to, or *; join with & so all must match.",
      "type": "string"
    },
    "selectors": {
      "oneOf": [
        {
          "$ref": "#/$defs/selector"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector"
          },
          "minItems": 1
        }
      ]
    }
  }
}
