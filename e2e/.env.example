# Copy to .env and adjust. Never put passwords or tokens here - sign-in is done manually via `npm run login`.

# Web client base URL (BC online). For on-prem/containers e.g. http://bcserver/BC
BC_BASE_URL=https://businesscentral.dynamics.com

# Optional tenant id or domain (e.g. contoso.onmicrosoft.com). Leave empty to use your home tenant.
BC_TENANT=

# Environment name
BC_ENVIRONMENT=sandbox

# Company the test runs in (demo data needed: customer + item below)
BC_COMPANY=CRONUS International Ltd.

# Process name of the recording; a timestamp is appended per run
BAS_PROCESS_NAME=Demo: Post sales order

# Sales order data
BC_CUSTOMER=Adatum Corporation
BC_ITEM_NO=1896-S

# Delay between Playwright actions in ms (makes the video watchable). 0 = full speed.
SLOWMO=250
