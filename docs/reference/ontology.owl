<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:vann="http://purl.org/vocab/vann/"
    xmlns:bca="https://schulzoli.github.io/BC-Atlas/ontology#">
  <owl:Ontology rdf:about="https://schulzoli.github.io/BC-Atlas/ontology">
    <rdfs:label>BC Atlas ontology for Business Central AL</rdfs:label>
    <rdfs:comment>Apps, namespaces, architecture components, AL objects, their members, and their relations, as found by BC Atlas in AL source.</rdfs:comment>
    <owl:versionInfo>0.11.0</owl:versionInfo>
    <dcterms:license rdf:resource="https://opensource.org/licenses/MIT"/>
    <vann:preferredNamespacePrefix>bca</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://schulzoli.github.io/BC-Atlas/ontology#</vann:preferredNamespaceUri>
  </owl:Ontology>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#App">
    <rdfs:label>AL app</rdfs:label>
    <rdfs:comment>An extension or app with its own app.json.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Namespace">
    <rdfs:label>AL namespace</rdfs:label>
    <rdfs:comment>A namespace declared by AL objects.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Component">
    <rdfs:label>Architecture component</rdfs:label>
    <rdfs:comment>A component of the target architecture in .bca.json, or of a proposal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Object">
    <rdfs:label>AL object</rdfs:label>
    <rdfs:comment>An application object such as a table, page, or codeunit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject">
    <rdfs:label>AL extension object</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:comment>An object that extends another object: a table, page, report, enum, profile, or permission set extension, or a page customization.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ExternalObject">
    <rdfs:label>External AL object</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:comment>An object referenced by the workspace but declared elsewhere, for example in the Base Application.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Field">
    <rdfs:label>Field</rdfs:label>
    <rdfs:comment>A field of a table or table extension.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Key">
    <rdfs:label>Key</rdfs:label>
    <rdfs:comment>A key of a table.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Procedure">
    <rdfs:label>Procedure</rdfs:label>
    <rdfs:comment>A procedure of an object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Trigger">
    <rdfs:label>Trigger</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Procedure"/>
    <rdfs:comment>A trigger of an object, such as OnRun or OnValidate.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#EventPublisher">
    <rdfs:label>Event publisher</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Procedure"/>
    <rdfs:comment>A procedure with an integration or business event attribute.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Relation">
    <rdfs:label>Relation</rdfs:label>
    <rdfs:comment>One relation found in the source, with its kind, confidence, and location (a qualified form of the direct relation property).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ArchitectureViolation">
    <rdfs:label>Architecture violation</rdfs:label>
    <rdfs:comment>A dependency between two objects that points against the architecture.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Table">
    <rdfs:label>Table</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#TableExtension">
    <rdfs:label>Table extension</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Page">
    <rdfs:label>Page</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#PageExtension">
    <rdfs:label>Page extension</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#PageCustomization">
    <rdfs:label>Page customization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Codeunit">
    <rdfs:label>Codeunit</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Report">
    <rdfs:label>Report</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ReportExtension">
    <rdfs:label>Report extension</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Query">
    <rdfs:label>Query</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#XmlPort">
    <rdfs:label>XMLport</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Enum">
    <rdfs:label>Enum</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#EnumExtension">
    <rdfs:label>Enum extension</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Interface">
    <rdfs:label>Interface</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ControlAddIn">
    <rdfs:label>Control add-in</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Profile">
    <rdfs:label>Profile</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ProfileExtension">
    <rdfs:label>Profile extension</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#PermissionSet">
    <rdfs:label>Permission set</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#PermissionSetExtension">
    <rdfs:label>Permission set extension</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Entitlement">
    <rdfs:label>Entitlement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#inApp">
    <rdfs:label>in app</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#App"/>
    <rdfs:comment>The app that declares the object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#inNamespace">
    <rdfs:label>in namespace</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Namespace"/>
    <rdfs:comment>The namespace of the object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#inComponent">
    <rdfs:label>in component</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:comment>The architecture component the object belongs to.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#dependsOnApp">
    <rdfs:label>depends on app</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#App"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#App"/>
    <rdfs:comment>A dependency declared in app.json.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#mayDependOn">
    <rdfs:label>may depend on</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:comment>A dependency the architecture allows.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#dependsOnComponent">
    <rdfs:label>depends on component</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:comment>A dependency between components that the source has today.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#hasField">
    <rdfs:label>has field</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Field"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#hasKey">
    <rdfs:label>has key</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Key"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#hasProcedure">
    <rdfs:label>has procedure</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Procedure"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#keyField">
    <rdfs:label>key field</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Key"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Field"/>
    <rdfs:comment>A field of the key, in order of declaration.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#dependsOn">
    <rdfs:label>depends on</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:comment>Any relation from one object to another; every relation property below is a kind of it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#relationSource">
    <rdfs:label>relation source</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Relation"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#relationTarget">
    <rdfs:label>relation target</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Relation"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#violationSource">
    <rdfs:label>violation source</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ArchitectureViolation"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#violationTarget">
    <rdfs:label>violation target</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ArchitectureViolation"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#sourceComponent">
    <rdfs:label>source component</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ArchitectureViolation"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#targetComponent">
    <rdfs:label>target component</rdfs:label>
    <rdfs:domain rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#ArchitectureViolation"/>
    <rdfs:range rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Component"/>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#calls">
    <rdfs:label>calls</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#dependsOn"/>
    <rdfs:comment>Calls a procedure of the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#reads">
    <rdfs:label>reads</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#dependsOn"/>
    <rdfs:comment>Reads records of the target table.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#writes">
    <rdfs:label>writes</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#dependsOn"/>
    <rdfs:comment>Inserts, modifies, or deletes records of the target table.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:ObjectProperty>
