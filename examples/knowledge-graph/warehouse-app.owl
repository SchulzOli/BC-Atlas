<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:bca="https://schulzoli.github.io/BC-Atlas/ontology#">
  <owl:Ontology rdf:about="urn:bc-atlas:graph">
    <rdfs:label>BC Atlas Warehouse Example</rdfs:label>
    <rdfs:comment>AL source analyzed by BC Atlas: 9 objects, 26 relations.</rdfs:comment>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-01T00:00:00.000Z</dcterms:created>
    <dcterms:creator>BC Atlas 0.11.0</dcterms:creator>
    <dcterms:conformsTo rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
    <rdfs:seeAlso rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Ontology>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#App">
    <rdfs:label>AL app</rdfs:label>
    <rdfs:comment>An extension or app with its own app.json.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Namespace">
    <rdfs:label>AL namespace</rdfs:label>
    <rdfs:comment>A namespace declared by AL objects.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Component">
    <rdfs:label>Architecture component</rdfs:label>
    <rdfs:comment>A component of the target architecture in .bca.json, or of a proposal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Object">
    <rdfs:label>AL object</rdfs:label>
    <rdfs:comment>An application object such as a table, page, or codeunit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ExtensionObject">
    <rdfs:label>AL extension object</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:comment>An object that extends another object: a table, page, report, enum, profile, or permission set extension, or a page customization.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#ExternalObject">
    <rdfs:label>External AL object</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Object"/>
    <rdfs:comment>An object referenced by the workspace but declared elsewhere, for example in the Base Application.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Field">
    <rdfs:label>Field</rdfs:label>
    <rdfs:comment>A field of a table or table extension.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Key">
    <rdfs:label>Key</rdfs:label>
    <rdfs:comment>A key of a table.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Procedure">
    <rdfs:label>Procedure</rdfs:label>
    <rdfs:comment>A procedure of an object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://schulzoli.github.io/BC-Atlas/ontology#Trigger">
    <rdfs:label>Trigger</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://schulzoli.github.io/BC-Atlas/ontology#Procedure"/>
