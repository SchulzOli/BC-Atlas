{
  "$schema": "./node_modules/bc-atlas/schemas/bca.schema.json",
  "view": "project",
  "projectRoot": ".",
  "direction": "right",
  "title": "Business Central architecture",
  "groupBy": "role",
  "roleMappings": {
    "Domain": [
      "Contoso.Sales:table:*",
      "Contoso.Sales:codeunit:*"
    ]
  },
  "namespaces": [
    "Contoso.**"
  ],
  "exclude": [
    "**/test/**"
  ],
  "moduleDepth": "auto",
  "folderDepth": 1,
  "includeUnresolvedCalls": false,
  "maxEdges": 500,
  "workflow": {
    "entries": [
      "ProcessDocument"
    ],
    "depth": 8,
    "maxNodes": 100,
    "maxEdges": 250,
    "edgeTypes": [
      "calls",
      "events",
      "writes"
    ],
    "phases": {
      "Validation": [
        "Validate*"
      ],
      "Processing": [
        "Process*",
        "Post*"
      ]
    },
    "stop": [
      "Finalize*"
    ],
    "collapse": [
      "*Telemetry*"
    ]
  },
  "details": false,
  "noExternal": false,
  "sourceUrl": "https://github.com/example/repo/blob/{ref}/{file}#L{line}",
  "sourceRef": "main",
  "sourcePathPrefix": "apps/Sales",
  "forbiddenDependencies": [
    {
      "from": "Contoso.Core:**",
      "to": "Contoso.UI:**",
      "severity": "warning",
      "message": "Core must not depend on UI"
    }
  ],
  "architecture": {
    "components": [
      { "name": "Core", "layer": 0, "match": ["namespace:Contoso.Core"], "exposes": ["type:interface,table", "object:codeunit:Core API"] },
      { "name": "Sales", "layer": 1, "match": ["namespace:Contoso.Sales"], "dependsOn": ["Core"], "maxObjects": 400 },
      { "name": "Integration", "layer": 2, "match": ["app:Contoso Integration"], "dependsOn": ["Sales"] }
    ],
    "allowSameLayer": false,
    "strictLayers": false,
    "maxObjects": 1500,
    "couplingWeights": { "reads": 2, "subscribes": 1 },
    "proposal": {
      "groupBy": "auto",
      "startFrom": ["namespace", "folder"],
      "ignore": ["permits", "includes"],
      "granularity": 1,
      "sharedCore": true,
      "keep": [{ "name": "Core", "match": ["namespace:Contoso.Core"], "description": "Defined by the team" }],
      "exclude": ["type:permissionset", "folder:test"],
      "moves": { "minGain": 2, "limit": 50 }
    },
    "severity": "error",
    "unassigned": "warning",
    "severities": {
      "internal-access": "warning",
      "unstable-dependency": "off"
    },
    "rules": [
      {
        "name": "owner-writes-its-tables",
        "from": "*",
        "to": "type:table",
        "kinds": ["writes"],
        "across": true,
        "severity": "error",
        "message": "Only the component that owns a table writes to it",
        "resolution": "Call a codeunit of the owning component that writes the record."
      },
      {
        "name": "core-has-no-ui",
        "from": "layer:0",
        "to": "type:page,report",
        "except": ["object:page:Core Setup"]
      }
    ]
  },
  "check": {
    "failOn": "error",
    "cycles": "warning",
    "maxFanIn": 25,
    "maxFanOut": 25
  },
  "simulation": {
    "company": "Contoso GmbH",
    "tests": "test",
    "taskGroups": [
      { "name": "Order entry", "description": "Take and release orders.", "features": ["sales-orders"] },
      { "name": "Posting", "tasks": ["sales-order-post"] }
    ],
    "roles": [
      { "name": "Order processor", "permissionSets": ["CONTOSO SALES"], "taskGroups": ["Order entry"], "mustNot": ["Posting"] },
      { "name": "Accountant", "permissionSets": ["CONTOSO SALES", "CONTOSO POST"], "taskGroups": ["Posting"] }
    ],
    "agents": [
      { "name": "Anna", "roles": ["Order processor"] },
      { "name": "Ben", "roles": ["Accountant"], "permissionSets": ["CONTOSO REPORTS"] }
    ],
    "requirements": [
      { "id": "REQ-1", "title": "Orders are released before they are posted", "tasks": ["sales-order-release", "sales-order-post"] },
      { "id": "REQ-2", "title": "Credit limits are checked", "objects": ["codeunit:Credit Limit Check"] }
    ],
    "fullAccess": ["SUPER"],
    "otherApps": "assume",
    "failOn": "error",
    "language": "en",
    "outputDir": "docs/simulation"
  },
  "al": {
    "compiler": "auto",
    "analyzers": ["CodeCop", "UICop"],
    "callGraph": true
  },
  "report": {
    "outputDir": "docs/atlas",
    "views": [
      "project",
      "module",
      "data",
      "contracts",
      "events",
      "ui"
    ],
    "format": "svg",
    "codegraph": false,
    "json": false
  }
}
