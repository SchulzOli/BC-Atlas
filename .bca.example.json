{
  "view": "project",
  "projectRoot": ".",
  "direction": "right",
  "title": "Business Central architecture",
  "groupBy": "role",
  "roleMappings": {
    "Domain": ["Contoso.Sales:table:*", "Contoso.Sales:codeunit:*"]
  },
  "namespaces": ["Contoso.**"],
  "exclude": ["**/test/**"],
  "moduleDepth": "auto",
  "folderDepth": 1,
  "includeUnresolvedCalls": false,
  "maxEdges": 500,
  "workflow": {
    "entries": ["ProcessDocument"],
    "depth": 8,
    "maxNodes": 100,
    "maxEdges": 250,
    "edgeTypes": ["calls", "events", "writes"],
    "phases": {
      "Validation": ["Validate*"],
      "Processing": ["Process*", "Post*"]
    },
    "stop": ["Finalize*"],
    "collapse": ["*Telemetry*"]
  },
  "details": false,
  "noExternal": false,
  "layout": "elk",
  "theme": 0,
  "sourceUrl": "https://github.com/example/repo/blob/{ref}/{file}#L{line}",
  "sourceRef": "main",
  "sourcePathPrefix": "apps/Sales",
  "forbiddenDependencies": [
    {
      "from": "Contoso.Core:**",
      "to": "Contoso.UI:**",
      "severity": "warning",
      "message": "Core must not depend on UI"
    }
  ]
}
