{
  "$schema": "./node_modules/bc-atlas/schemas/bca.schema.json",
  "projectRoot": ".",
  "title": "Business Central architecture",
  "namespaces": [
    "Contoso.**"
  ],
  "exclude": [
    "**/test/**"
  ],
  "sourceUrl": "https://github.com/example/repo/blob/{ref}/{file}#L{line}",
  "sourceRef": "main",
  "sourcePathPrefix": "apps/Sales",
  "forbiddenDependencies": [
    {
      "from": "Contoso.Core:**",
      "to": "Contoso.UI:**",
      "severity": "warning",
      "message": "Core must not depend on UI"
    }
  ],
  "check": {
    "failOn": "error",
    "cycles": "warning",
    "maxFanIn": 25,
    "maxFanOut": 25
  },
  "layers": {
    "outputDir": "docs/layers",
    "pictures": "auto"
  }
}
