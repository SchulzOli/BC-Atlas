direction: right
title: "AL project architecture" {
  shape: text
  near: top-center
  style.font-size: 28
}

g0: "Demo.Operations" {
  style.stroke-dash: 3
  n0: "codeunit 50110\nSales Operations" {
    shape: rectangle
    tooltip: "test\\fixtures\\Operations.al:5"
    style.fill: "#FFF0D6"
    style.stroke: "#A96300"
  }
}

g1: "Demo.Sales" {
  style.stroke-dash: 3
  n4: "tableextension 50102\nCustomer Sales Ext." {
    shape: rectangle
    tooltip: "test\\fixtures\\Sales.al:37"
    style.fill: "#DCEBFF"
    style.stroke: "#2362A2"
    style.stroke-dash: 4
  }
  n1: "interface\nPosts Sales" {
    shape: rectangle
    tooltip: "test\\fixtures\\Sales.al:3"
    style.fill: "#FFF8C9"
    style.stroke: "#8B7400"
  }
  n2: "table 50100\nSales Buffer" {
    shape: rectangle
    tooltip: "test\\fixtures\\Sales.al:8"
    style.fill: "#DCEBFF"
    style.stroke: "#2362A2"
  }
  n5: "page 50103\nSales Buffer List" {
    shape: rectangle
    tooltip: "test\\fixtures\\Sales.al:41"
    style.fill: "#E5F6E8"
    style.stroke: "#31783B"
  }
  n3: "codeunit 50101\nSales Poster" {
    shape: rectangle
    tooltip: "test\\fixtures\\Sales.al:16"
    style.fill: "#FFF0D6"
    style.stroke: "#A96300"
  }
}

external: "External / unresolved" {
  style.stroke-dash: 5
  e0: "table\ncustomer" {
    style.fill: "#FAFAFA"
    style.stroke: "#999999"
  }
}

g0.n0 -> g1.n2: "uses" {style.stroke-dash: 3}
g0.n0 -> g1.n3: "uses" {style.stroke-dash: 3}
g0.n0 -> g1.n3: "reads"
g1.n3 --> g1.n1: "implements"
g1.n3 -> g1.n2: "uses" {style.stroke-dash: 3}
g1.n3 -> external.e0: "uses" {style.stroke-dash: 3}
g1.n4 --> external.e0: "extends"
g1.n5 -> g1.n2: "reads"
