# ─────────────────────────────────────────────────────────────────────────────
# BC OpenBridge – Konfiguration (Umgebungsvariablen)
# Geheimnisse können auch als Datei übergeben werden: <NAME>_FILE=/run/secrets/…
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Öffentliche URL des Gateways (für Links, Location-Header, BC-Webhook-Callback)
PUBLIC_BASE_URL=https://bc-gateway.example.com
# true, wenn ein Reverse Proxy X-Forwarded-For setzt
TRUST_PROXY=false
# Browser-Origins, die die API per CORS nutzen dürfen (kommagetrennt)
CORS_ORIGINS=
BODY_LIMIT_BYTES=262144
LOG_LEVEL=info

# ── Business Central (Service-to-Service, Entra ID Client Credentials) ──────
BC_TENANT_ID=00000000-0000-0000-0000-000000000000
BC_ENVIRONMENT=production
BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Variante A: Client Secret
BC_CLIENT_SECRET=
# Variante B (empfohlen): Zertifikat – kein geteiltes Geheimnis
# BC_CLIENT_CERT_FILE=/run/secrets/bc-cert.pem
# BC_CLIENT_KEY_FILE=/run/secrets/bc-key.pem
# Nur diese Mandanten freigeben (Company-IDs, kommagetrennt; leer = alle)
BC_ALLOWED_COMPANIES=
# Nur diese Entitätsmengen veröffentlichen (leer = alle aus dem Registry)
BC_ENTITIES=
BC_TIMEOUT_MS=30000
BC_MAX_RETRIES=4

# ── Webhooks von Business Central ───────────────────────────────────────────
# Entitäten, für die BC Änderungsbenachrichtigungen schickt
BC_SUBSCRIBE=customers,vendors,items,salesOrders
# Gemeinsames Geheimnis, das BC in jeder Benachrichtigung mitsendet (≥ 16 Zeichen)
BC_WEBHOOK_CLIENT_STATE=
BC_SUBSCRIPTION_RENEW_MS=43200000

# ── Authentifizierung der Clients ───────────────────────────────────────────
# OAuth 2.0 / OIDC (z. B. Entra ID, Keycloak, Auth0, Okta)
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUDIENCE=api://bc-openbridge
# OIDC_JWKS_URI=   (optional, sonst per Discovery)
# API-Keys (nur Hashes!) – erzeugen mit: npm run create-api-key -- --name X --scopes bc.read --file api-keys.json
API_KEYS_FILE=./api-keys.json

# ── Sicherheit ──────────────────────────────────────────────────────────────
# Schlüssel für verschlüsselte Paging-Cursor (≥ 32 Zeichen, für alle Replikas gleich)
CURSOR_SECRET=
RATE_LIMIT_RPM=600
RATE_LIMIT_BURST=100
RATE_LIMIT_IP_RPM=1200
AUDIT_LOG_FILE=./audit.jsonl
AUDIT_LOG_READS=true
METRICS_PUBLIC=false

# ── Ausgehende Events (CloudEvents über Standard Webhooks) ──────────────────
EVENT_SUBSCRIBERS_FILE=./event-subscribers.json
EVENT_TYPE_PREFIX=io.openbridge.bc
# Nur für lokale Entwicklung:
OUTBOUND_ALLOW_HTTP=false
OUTBOUND_ALLOW_PRIVATE=false

# ── KI-Agenten ──────────────────────────────────────────────────────────────
MCP_ENABLED=true
