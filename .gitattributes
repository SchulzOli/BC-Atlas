* text=auto
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.al text eol=lf
# Generated files are compared byte for byte, on every system.
*.svg text eol=lf
*.html text eol=lf
*.ttl text eol=lf
*.owl text eol=lf
*.d2 text eol=lf
*.bpmn text eol=lf
*.dita text eol=lf
*.ditamap text eol=lf
*.wasm binary
*.png binary
*.jpg binary

# Azure DevOps CSV keeps CRLF and its BOM exactly as generated
*.csv -text
